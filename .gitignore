# ClickOnce temporary signing keys
*_TemporaryKey.pfx

# Visual Studio 2010 / general cache and log files
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.log
*.tlog

# Windows thumbnail and folder cache files
Thumbs.db
ehthumbs.db
Desktop.ini
